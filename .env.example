# ============================================================================
# AI Financial Risk Intelligence Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it's in .gitignore for security
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL connection details
# Host: Use 172.**.**.1 for WSL2 to Windows, localhost for native Linux
# Database: financial_risk (main app data)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=172.**.**.1
POSTGRES_PORT=5432
POSTGRES_DB=financial_risk

# SQLAlchemy connection string (auto-constructed from above for Flask/SQLAlchemy)
# Format: postgresql+psycopg2://user:password@host:port/database
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_password_here@172.**.**.1:5432/financial_risk

# ============================================================================
# AIRFLOW CONFIGURATION
# ============================================================================
# Apache Airflow for data pipeline orchestration

AIRFLOW_HOME=/home/chitr/financial-risk-platform/airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:your_secure_password_here@172.**.**.1:5432/airflow_db
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1
AIRFLOW__SCHEDULER__CATCHUP_BY_DEFAULT=False
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key_here_change_in_production

# ============================================================================
# MLFLOW CONFIGURATION
# ============================================================================
# MLflow for model tracking, versioning, and registry

MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=stock_risk_prediction
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://postgres:your_secure_password_here@172.**.**.1:5432/mlflow_tracking
MLFLOW_DEFAULT_ARTIFACT_ROOT=/home/chitr/mlflow-artifacts

# ============================================================================
# GROQ API CONFIGURATION
# ============================================================================
# Free LLM API for generative AI features
# Get your API key from: https://console.groq.com
# Free tier: 500 requests/day (sufficient for development)

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# ============================================================================
# DATA SOURCE CONFIGURATION
# ============================================================================
# External data providers for enrichment (optional)

# Alpha Vantage - Stock market data (optional)
# Free tier: 5 requests/minute, 500/day
ALPHA_VANTAGE_KEY=optional_key_here

# Finnhub - Financial data and news (optional)
# Free tier: 250 API calls/minute
FINNHUB_KEY=optional_key_here

# SEC EDGAR Configuration
# Used for fetching 10-K filings from SEC database
SEC_EDGAR_USER_AGENT=your_email@example.com
SEC_FILINGS_PATH=./data/sec_filings
SEC_FILINGS_CACHE_DAYS=90

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Core application settings

APP_ENV=development
# Options: development, staging, production
# Development: Full debug output, verbose logging
# Staging: Limited debug, standard logging
# Production: Errors only, no debug info

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

DEBUG=False
# Set to True only in development for verbose output

APP_NAME=Financial Risk Intelligence Platform
APP_VERSION=1.0.0
TIMEZONE=America/New_York

# ============================================================================
# FEATURE ENGINEERING CONFIGURATION
# ============================================================================
# PySpark and feature engineering settings

FEATURE_STORE_PATH=./data/features
FEATURE_STORE_FORMAT=parquet
LOOKBACK_DAYS=252
LABEL_HORIZON_DAYS=30
RISK_THRESHOLD=0.03  # 3% price drop threshold for HIGH risk label

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_MEMORY=4g
SPARK_PARTITIONS=8

# ============================================================================
# ML MODEL CONFIGURATION
# ============================================================================
# Machine learning model paths and settings

MODEL_PATH=./ml_models/models/lightgbm_best.pkl
SCALER_PATH=./ml_models/models/scaler.pkl
LABEL_ENCODER_PATH=./ml_models/models/label_encoder.pkl

# Model hyperparameters (for retraining)
LIGHTGBM_NUM_LEAVES=50
LIGHTGBM_LEARNING_RATE=0.05
LIGHTGBM_NUM_BOOST_ROUNDS=200
LIGHTGBM_EARLY_STOPPING_ROUNDS=10

XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_N_ESTIMATORS=200

RANDOM_FOREST_N_ESTIMATORS=100
RANDOM_FOREST_MAX_DEPTH=15

# ============================================================================
# RAG & VECTOR DATABASE CONFIGURATION
# ============================================================================
# Retrieval-Augmented Generation for SEC filing analysis

FAISS_INDEX_PATH=./data/embeddings/faiss_index
FAISS_INDEX_DIMENSION=384  # For all-MiniLM-L6-v2 model

# Embeddings Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu  # Options: cpu, cuda, mps (for GPU)

# RAG Configuration
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5  # Number of documents to retrieve
RAG_SIMILARITY_THRESHOLD=0.5

# ============================================================================
# LANGRAPH AGENT CONFIGURATION
# ============================================================================
# Multi-agent workflow orchestration

AGENT_TIMEOUT=30  # seconds
AGENT_MAX_ITERATIONS=10
SUPERVISOR_MODEL=llama-3.1-70b-versatile
RESEARCH_AGENT_MODEL=llama-3.1-70b-versatile
SENTIMENT_AGENT_MODEL=llama-3.1-70b-versatile
RISK_AGENT_MODEL=llama-3.1-70b-versatile
REPORT_AGENT_MODEL=llama-3.1-70b-versatile

# ============================================================================
# FASTAPI CONFIGURATION
# ============================================================================
# REST API server settings

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True  # Auto-reload on file changes (development only)
API_WORKERS=4

# CORS Configuration
CORS_ORIGINS=["http://localhost:8501", "http://localhost:3000"]
CORS_CREDENTIALS=True
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Rate Limiting (optional, for production)
RATE_LIMIT_ENABLED=False
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600  # seconds

# ============================================================================
# STREAMLIT CONFIGURATION
# ============================================================================
# Dashboard UI settings

STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=True
STREAMLIT_SERVER_MAXUPLOADSIZE=200  # MB
STREAMLIT_LOGGER_LEVEL=info

# ============================================================================
# STOCKS & TRACKING CONFIGURATION
# ============================================================================
# Which stocks to monitor

TRACKED_TICKERS=AAPL,MSFT,GOOGL,TSLA,AMZN,META,NVDA,JPM,BAC,GS
# Format: Comma-separated stock tickers

# Data refresh frequency (Airflow DAG schedule)
DATA_REFRESH_INTERVAL=@daily  # Airflow cron format
FEATURE_REFRESH_INTERVAL=@daily
MODEL_RETRAINING_INTERVAL=@monthly

# ============================================================================
# STORAGE & CACHING CONFIGURATION
# ============================================================================
# Local file system and caching

DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
MODELS_DIR=./ml_models/models
ARTIFACTS_DIR=./artifacts

# Caching
CACHE_ENABLED=True
CACHE_TTL_HOURS=24  # Time-to-live for cache

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# API authentication and security

SECRET_KEY=your_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Key Authentication (optional)
API_KEY_ENABLED=False
API_KEY=your_api_key_here

# ============================================================================
# MONITORING & LOGGING CONFIGURATION
# ============================================================================
# Application monitoring and observability

LOG_FORMAT=json  # Options: json, text
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5

# Prometheus Metrics (optional, for production)
PROMETHEUS_ENABLED=False
PROMETHEUS_PORT=9090

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================
# For development and testing only

PYTEST_TIMEOUT=30
TEST_DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/test_financial_risk
SEED=42  # For reproducibility

# ============================================================================
# NOTES
# ============================================================================
# 1. WSL2 Configuration:
#    - POSTGRES_HOST should be 172.**.**.1 (WSL2 gateway to Windows)
#    - Not localhost, as PostgreSQL runs on Windows, not in WSL
#
# 2. Security Best Practices:
#    - NEVER commit .env to version control
#    - Use strong passwords in production
#    - Rotate API keys regularly
#    - Use environment variable management tools (AWS Secrets Manager, HashiCorp Vault)
#
# 3. Production Checklist:
#    - Change all default passwords
#    - Set DEBUG=False
#    - Set APP_ENV=production
#    - Use environment-specific .env files (.env.production)
#    - Enable API authentication (API_KEY_ENABLED=True)
#    - Set up proper logging and monitoring
#    - Use HTTPS for all API endpoints
#    - Configure CORS_ORIGINS for specific domains only
#
# 4. Optional Features:
#    - Alpha Vantage & Finnhub keys: Required if using their data sources
#    - Prometheus/Grafana: For advanced monitoring
#    - Docker: Set up Docker compose for containerization
#
# 5. Troubleshooting:
#    - If PostgreSQL connection fails, verify:
#      a) PostgreSQL is running
#      b) pg_hba.conf allows connections from your network
#      c) Firewall rules allow port 5432
#      d) Correct IP address (172.**.**.1 for WSL2)
#
#    - If Groq API fails, verify:
#      a) API key is valid and not expired
#      b) You haven't exceeded rate limits (500 req/day free)
#      c) Internet connection is active
#
#    - If FAISS fails, verify:
#      a) Vector dimension matches model (384 for all-MiniLM-L6-v2)
#      b) Enough disk space for index
#
# ============================================================================
